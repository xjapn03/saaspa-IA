# ==== saaspa-IA (servicio de IA) ====
# Copia este archivo a .env (ignorado por git) y ajusta los valores.
# Nunca se commitean secretos reales.

# LLM (DeepSeek) - el modelo debe soportar tool calling.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Persistencia: PostgreSQL 15 + pgvector, esquema propio `ia`.
DATABASE_URL=jdbc:postgresql://localhost:5433/saaspa_ia
DATABASE_USER=saaspa
DATABASE_PASSWORD=saaspa

# Backend NestJS (API interna /api/internal/v1).
BACKEND_URL=http://localhost:3001

# Claves de servicio. Son DOS secretos distintos, uno por direccion (no unificar):
# - INTERNAL_API_KEY: la envia este servicio al llamar a NestJS (IA -> NestJS).
# - IA_BOT_API_KEY:   la envia NestJS al llamar a este servicio (NestJS -> IA).
INTERNAL_API_KEY=
IA_BOT_API_KEY=

# Timeouts del cliente HTTP hacia NestJS (formato Duration: 1s, 500ms).
BACKEND_CONNECT_TIMEOUT=1s
BACKEND_READ_TIMEOUT=5s

# Turn token: verificacion asimetrica ES256 (P-256). Solo claves publicas, por kid (ADR 0006).
# El material va en base64 (una linea) o como PEM en crudo. Dos ranuras para rotar sin cortar el servicio.
TURN_TOKEN_AUDIENCE=saaspa-ia
TURN_TOKEN_ISSUER=
TURN_TOKEN_KEY_CURRENT_KID=
TURN_TOKEN_KEY_CURRENT_PUBLIC_KEY=
TURN_TOKEN_KEY_PREVIOUS_KID=
TURN_TOKEN_KEY_PREVIOUS_PUBLIC_KEY=

# Tenant del piloto (id y nombre visible) y zona horaria del negocio (prompt y agenda).
IA_TENANT_DEFAULT=kamerinos
IA_TENANT_DISPLAY_NAME=Kamerinos SPA Bogota
IA_TENANT_TIMEZONE=America/Bogota

# Agente: ventana de memoria (mensajes que se envian al modelo).
IA_AGENT_MEMORY_WINDOW=10

# Cliente HTTP hacia el modelo (ADR 0009): timeouts explicitos, aparte del backend.
LLM_CONNECT_TIMEOUT=3s
LLM_READ_TIMEOUT=10s

# Tope total del turno conversacional (llamada al modelo + herramientas).
# Escalera end-to-end (ADR 0014): read-timeout (10s) < turn-deadline (20s) < IA_BOT_TIMEOUT_MS del
# backend (25s). No subir el deadline por encima del timeout con el que NestJS llama a este servicio.
LLM_TURN_DEADLINE=20s

# Tope de coste por tenant y por conversacion (ADR 0010). Fuente de verdad: `ia.turn_log`
# (tokens y latencia por turno), sin contador en memoria. Respuesta 429 al superarlo.
IA_COST_GUARD_ENABLED=true
IA_COST_GUARD_WINDOW=1h
# Por que estos numeros por defecto: 240 turnos/hora por tenant son ~4 por minuto sostenidos (el backend ya
# corta a 20 req/min por IP y a 30 mensajes/hora por sesion anonima), y 30 turnos/hora por conversacion es
# el mismo tope que ANONYMOUS_MESSAGE_CAP del backend, para no cortar antes que el gateway. Los topes de
# tokens (~1M por tenant y ~150k por conversacion) salen del turno medido en el E2E: ~4.000 tokens.
IA_COST_GUARD_TENANT_MAX_TURNS=240
IA_COST_GUARD_TENANT_MAX_TOKENS=1000000
IA_COST_GUARD_CONVERSATION_MAX_TURNS=30
IA_COST_GUARD_CONVERSATION_MAX_TOKENS=150000
# Tope por ORIGEN del turno (ADR 0020 / H-04): 60 turnos/hora. Corta el abuso desde una sola IP, que antes
# podia agotar los 240 del tenant en ~12 minutos y dejar fuera a todas las clientas. El origen es el usuario
# si el turno esta identificado y la IP que resuelve el backend con su proxy de confianza si es anonimo (claim
# clientIp, ya emitido por saaspa-backend): el canal anonimo esta cubierto.
IA_COST_GUARD_ORIGIN_MAX_TURNS=60
# Sal del hash con el que se guarda el origen (nunca la IP en claro). Fallo cerrado (HN-01): fuera del
# perfil local el ARRANQUE FALLA si falta, esta en blanco, mide menos de 16 caracteres o es la constante
# legada del repo. En local sin sal se genera una aleatoria por proceso. Genera: openssl rand -hex 32
IA_COST_GUARD_ORIGIN_SALT=

PORT=8000
