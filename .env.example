# ==== saaspa-IA (servicio de IA) ====
# Copia este archivo a .env (ignorado por git) y ajusta los valores.
# Nunca se commitean secretos reales.

# LLM (DeepSeek) - el modelo debe soportar tool calling.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Persistencia: PostgreSQL 15 + pgvector, esquema propio `ia`.
DATABASE_URL=jdbc:postgresql://localhost:5433/saaspa_ia
DATABASE_USER=saaspa
DATABASE_PASSWORD=saaspa

# Redis estandar (idempotencia, rate limiting, cache).
REDIS_URL=redis://localhost:6380

# Backend NestJS (API interna /api/internal/v1).
BACKEND_URL=http://localhost:3001

# Claves de servicio. Son DOS secretos distintos, uno por direccion (no unificar):
# - INTERNAL_API_KEY: la envia este servicio al llamar a NestJS (IA -> NestJS).
# - IA_BOT_API_KEY:   la envia NestJS al llamar a este servicio (NestJS -> IA).
INTERNAL_API_KEY=
IA_BOT_API_KEY=

# Turn token: verificacion asimetrica ES256 (P-256, PEM, kid). Solo clave publica (ADR 0006).
# T1.1: pasa a un mapa kid -> PEM para aceptar dos claves publicas y rotar sin cortar el servicio.
TURN_TOKEN_PUBLIC_KEY=

# Tenant por defecto del piloto.
IA_TENANT_DEFAULT=kamerinos
PORT=8000
